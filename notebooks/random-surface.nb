Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{"monomialList", "[", 
   RowBox[{"vars_List", ",", 
    RowBox[{"m_Integer", "?", "NonNegative"}]}], "]"}], ":=", 
  RowBox[{"Flatten", "[", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Apply", "[", 
       RowBox[{"Times", ",", 
        RowBox[{"vars", "^", "#"}]}], "]"}], "&"}], ",", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"FrobeniusSolve", "[", 
        RowBox[{
         RowBox[{"ConstantArray", "[", 
          RowBox[{"1", ",", 
           RowBox[{"Length", "[", "vars", "]"}]}], "]"}], ",", "k"}], "]"}], 
       ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "0", ",", "m"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", "2", "}"}]}], "]"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"randPoly2", "[", "deg_", "]"}], ":=", " ", "\[IndentingNewLine]", 
  RowBox[{"(", " ", 
   RowBox[{
    RowBox[{"l", "=", 
     RowBox[{"monomialList", "[", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "y"}], "}"}], ",", " ", "deg"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Total", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"RandomInteger", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "10"}], ",", "10"}], "}"}], "]"}], "*", "#"}], " ", 
       "&"}], "/@", " ", "l"}], "]"}]}], "\[IndentingNewLine]", 
   ")"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"randPoly3", "[", "deg_", "]"}], ":=", " ", "\[IndentingNewLine]", 
   RowBox[{"(", " ", 
    RowBox[{
     RowBox[{"l", "=", 
      RowBox[{"monomialList", "[", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", " ", "deg"}], "]"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"RandomInteger", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "10"}], ",", "10"}], "}"}], "]"}], "*", "#"}], " ", 
        "&"}], "/@", " ", "l"}], "]"}]}], "\[IndentingNewLine]", ")"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Panel", "[", "\[IndentingNewLine]", 
  RowBox[{"DynamicModule", "[", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"deg", "=", "1"}], ",", " ", 
      RowBox[{"f", "=", "1"}]}], "}"}], ",", " ", "\[IndentingNewLine]", 
    RowBox[{"Column", "[", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<Degree \>\"", ",", " ", 
           RowBox[{"Dynamic", "[", "deg", "]"}], ",", " ", 
           RowBox[{"Slider", "[", 
            RowBox[{
             RowBox[{"Dynamic", "[", "deg", "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", "10", ",", "1"}], "}"}]}], "]"}], ",", " ", 
           RowBox[{"Dynamic", "[", 
            RowBox[{"Button", "[", 
             RowBox[{"\"\<New surface\>\"", ",", " ", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"f", "=", 
                RowBox[{"randPoly3", "[", "deg", "]"}]}], ";"}]}], "]"}], 
            "]"}]}], "}"}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Dynamic", "[", 
         RowBox[{"ContourPlot3D", "[", 
          RowBox[{
           RowBox[{"f", "\[Equal]", "0"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"x", ",", " ", 
             RowBox[{"-", "10"}], ",", " ", "10"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"y", ",", " ", 
             RowBox[{"-", "10"}], ",", " ", "10"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"z", ",", 
             RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", " ", 
           RowBox[{"Mesh", "\[Rule]", "False"}], ",", " ", 
           RowBox[{"PlotPoints", "\[Rule]", " ", "60"}], ",", " ", 
           RowBox[{"ImageSize", "\[Rule]", "Large"}]}], "]"}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Dynamic", "[", "f", "]"}]}], "\[IndentingNewLine]", "}"}], 
      ",", "  ", "Center", ",", " ", 
      RowBox[{"ItemSize", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"100", ",", "Automatic"}], "}"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", "]"}]}], "Input",
