   RowBox[{
    RowBox[{"l", "=", 
     RowBox[{"monomialList", "[", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", " ", "deg"}], "]"}]}], 
    ";", "\[IndentingNewLine]", 
    RowBox[{"Total", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"RandomInteger", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "10"}], ",", "10"}], "}"}], "]"}], "*", "#"}], " ", 
